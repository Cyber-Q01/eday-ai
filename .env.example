# ---- LLM (optional: if unset, runs in MOCK mode with built-in rule intent engine) ----
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# LLM_MODE: auto | mock | openai   (auto = openai if key present, else mock)
LLM_MODE=auto

# ---- LLM provider ----
# LLM_PROVIDER: auto | mock | openai | gemini | litellm   (auto = openai key → gemini key → mock)
# LLM_FALLBACK_MODELS: tried in order when the primary model is overloaded (429/5xx)
#   e.g. LLM_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-flash-latest
LLM_PROVIDER=auto
OPENAI_API_KEY=
GEMINI_API_KEY=
# LLM_BASE_URL — leave empty to use the provider default. For Gemini the default is
# https://generativelanguage.googleapis.com/v1beta/openai/ (OpenAI-compatible).
# For custom endpoints (LiteLLM/Groq/Together) set OPENAI_API_KEY + LLM_BASE_URL.
LLM_BASE_URL=
LLM_MODEL=
# Examples: LLM_MODEL=gemini-2.5-flash   |   LLM_MODEL=gpt-4o-mini   |   LLM_MODEL=llama-3.3-70b-versatile (Groq)
#
# --- LiteLLM proxy (FREE — self-hosted, MIT). Paid only if you use their managed cloud. ---
# Run `docker compose up` — it starts litellm on :4000 and points eday-ai at it.
# Or self-host separately and set:
# LLM_PROVIDER=litellm
# LLM_BASE_URL=http://localhost:4000/v1        # your proxy
# OPENAI_API_KEY=sk-your-litellm-master-key    # proxy master key (not an OpenAI key)
# LLM_MODEL=gemini-flash                       # alias from litellm/config.yaml

# --- Embeddings (vector memory) ---
# EMBEDDING_PROVIDER=auto   # auto = gemini when GEMINI_API_KEY set, else mock (deterministic, 768-dim)
# EMBEDDING_MODEL=gemini-embedding-001        # Gemini embedding, pinned to 768-dim (free tier)
# EMBEDDING_DIM=768

# ---- Server ----
PORT=3000
# CORS origin for the built-in playground (comma separated). * = all
CORS_ORIGINS=*
# Internal key required on /v1/* calls (empty = open, fine for testing)
API_KEY=

# ---- Behaviour ----
# Skip payment confirmations entirely (testing only!). Default false = confirm every payment tool call
SKIP_CONFIRM=false
# Simulated wallet balance per new user (NGN)
MOCK_WALLET_BALANCE=50000
# Max steps an orchestrator plan may run per task
MAX_PLAN_STEPS=6
# Memory persistence file (omit = in-memory only)
MEMORY_FILE=./data/memory.json
# --- Supabase BaaS (optional): persist memory + audit in your Eday Supabase project ----
# 1) Run supabase/schema.sql in your project SQL editor
# 2) Project Settings → API → URL + service_role key (server-only — NEVER in frontend code)
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# --- WhatsApp Cloud API (Meta) — optional channel ---
# WHATSAPP_VERIFY_TOKEN=<any secret string YOU make up>   # must match the token you enter in Meta's webhook form
# WHATSAPP_TOKEN=<system-user access token>               # Meta dashboard → WhatsApp → API Setup (temporary) or Business Settings → System users (permanent)
# WHATSAPP_PHONE_ID=<phone number id>                     # Meta dashboard → WhatsApp → API Setup ("Phone number ID")
# WHATSAPP_APP_SECRET=<app secret>                        # optional but recommended → verifies webhook signatures
# WHATSAPP_GRAPH_VERSION=v22.0                            # optional; override if Meta deprecates
# WHATSAPP_DRY_RUN=true                                   # testing only: log replies instead of sending to Graph

# STORE_BACKEND=auto   # auto = supabase when URL+key set, else file, else memory

# ---- Optional real backend mode (later, when Supabase backend is live) ----
# TOOL_MODE=mock | http   — http calls real endpoints; mock uses built-in simulator
TOOL_MODE=mock
BACKEND_INTERNAL_URL=
BACKEND_INTERNAL_KEY=
